<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required so the migration build can verify the permanent owner's
         signing certificate before transferring Device Owner. -->
    <queries>
        <package android:name="com.albugimed.app" />
    </queries>

    <!-- Parcours de demande via notification (variante T2-A). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Variante T2-B uniquement : exemption de lancement d'activité en arrière-plan. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Le délai d'une autorisation temporaire fait partie de la politique coercitive. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!--
         Ajoutée sciemment le 31/07/2026, contrat §10. L'application n'avait
         aucune permission réseau : l'exfiltration était impossible par
         construction, et cette garantie est perdue. Elle est remplacée par
         quatre garanties de conception, dont la première est vérifiable ici
         même : toute la surface réseau tient dans `sync/SyncTransport.kt`,
         trois points de terminaison, un seul hôte, aucune bibliothèque HTTP.
         Aucune donnée de coercition ne traverse ce contrat (P4-08-A1).
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:name=".App"
        android:label="${applicationLabel}"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/Theme.BlockerSpike"
        android:allowBackup="false">

        <!-- Optional vendor libraries used only if a later T3 test enables the
             LiteRT-LM GPU backend. The first device run stays on CPU. -->
        <uses-native-library
            android:name="libvndksupport.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".study.StudyQueueActivity"
            android:exported="false" />
        <activity
            android:name=".study.DeclareActivity"
            android:exported="false" />

        <!-- N'imite jamais l'application bloquée : écran neutre, hors des récents. -->
        <activity
            android:name=".gate.BlockGateActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop" />

        <service
            android:name=".service.BlockerAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- A native-model crash or memory kill must not take the Device Owner
             policy process down with it. -->
        <service
            android:name=".inference.InferenceService"
            android:exported="false"
            android:process=":inference" />

        <receiver
            android:name="${deviceAdminReceiverClass}"
            android:description="@string/device_admin_description"
            android:exported="true"
            android:label="${applicationLabel}"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".admin.PolicyReconcileReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
