<?xml version="1.0" encoding="utf-8"?>
<!--
  Identique a `ic_launcher` : c'est le systeme qui decoupe la forme, ronde ou
  non, dans la meme icone adaptative. Le fichier existe parce que certains
  lanceurs demandent explicitement `roundIcon`, pas parce que le dessin change.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
